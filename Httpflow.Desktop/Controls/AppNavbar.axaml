<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Httpflow.Desktop.Controls.AppNavbar">
    <Border Padding="16,12">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Button Content="Profile"/>
            <Button x:Name="ProjectsButton"
                    Content="Projects"
                    Click="ProjectsButton_OnClick"/>
            <Button x:Name="WorkspaceButton"
                    Content="Workspace"
                    Click="WorkspaceButton_OnClick"/>
            <Button x:Name="DashboardButton"
                    Content="Dashboard"
                    Click="DashboardButton_OnClick"/>
            <Button Content="Variables"/>
            <Button Content="Logs"/>
            <Button Content="Run"/>
        </StackPanel>
    </Border>
</UserControl>
