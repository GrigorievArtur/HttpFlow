<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Httpflow.Desktop.Features.Collaborators.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="700"
             x:DataType="vm:CollaboratorDashboardViewModel"
             x:Class="Httpflow.Desktop.Features.Collaborators.Views.CollaboratorDashboardView">

    <Grid Margin="18"
          ColumnDefinitions="*,*"
          ColumnSpacing="18">
        <Grid RowDefinitions="Auto,*"
              RowSpacing="12">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <TextBox x:Name="SearchTextBox"
                         PlaceholderText="Search collaborators"
                         Text="{Binding SearchText, Mode=TwoWay}"/>
                <Button Grid.Column="1"
                        MinWidth="128"
                        Command="{Binding CycleSortModeCommand}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <PathIcon Width="14"
                                  Height="14"
                                  Data="M6,3 L3,6 L5,6 L5,15 L7,15 L7,6 L9,6 Z M14,17 L17,14 L15,14 L15,5 L13,5 L13,14 L11,14 Z"/>
                        <TextBlock Text="{Binding SortButtonText}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                <ScrollViewer>
                    <StackPanel x:Name="CollaboratorsListPanel"
                                Spacing="0"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Column="1"
              RowDefinitions="Auto,Auto,*"
              RowSpacing="14">
            <StackPanel Spacing="5">
                <TextBlock x:Name="ProjectTextBlock"
                           Text="{Binding ProjectText}"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusTextBlock"
                           Text="{Binding StatusText}"
                           Opacity="0.72"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Classes.dashboard-panel="True">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="10">
                    <TextBlock Text="Invite collaborator"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,150"
                          ColumnSpacing="10">
                        <TextBox x:Name="InviteEmailTextBox"
                                 PlaceholderText="collaborator@company.com"
                                 Text="{Binding InviteEmail, Mode=TwoWay}"/>
                        <ComboBox x:Name="InviteRoleComboBox"
                                  Grid.Column="1"
                                  SelectedIndex="1"
                                  IsEnabled="{Binding IsManagementEnabled}">
                            <ComboBoxItem Content="Admin"/>
                            <ComboBoxItem Content="Member"/>
                            <ComboBoxItem Content="Visitor"/>
                        </ComboBox>
                    </Grid>

                    <Button x:Name="InviteButton"
                            Grid.Row="2"
                            HorizontalAlignment="Right"
                            Content="Invite"
                            Command="{Binding InviteCollaboratorCommand}"
                            IsEnabled="{Binding IsManagementEnabled}"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Classes.dashboard-panel="True">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="16">
                    <TextBlock Text="Selected collaborator"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <Grid Grid.Row="1"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                          ColumnDefinitions="130,*"
                          RowSpacing="14"
                          ColumnSpacing="12">
                        <TextBlock Text="Name"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedNameTextBlock"
                                   Grid.Column="1"
                                   Text="{Binding SelectedCollaboratorName}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1"
                                   Text="Email"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="SelectedEmailTextBlock"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding SelectedCollaboratorEmail}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="2"
                                   Text="Role"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="RoleComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Width="180"
                                  HorizontalAlignment="Left"
                                  IsEnabled="{Binding CanEditSelectedRole}"
                                  SelectionChanged="OnRoleComboBoxSelectionChanged">
                            <ComboBoxItem Content="Admin"/>
                            <ComboBoxItem Content="Member"/>
                            <ComboBoxItem Content="Visitor"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3"
                                   Text="Status"
                                   FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding SelectedCollaboratorStatus}"/>

                        <TextBlock Grid.Row="4"
                                   Text="Joined"
                                   FontWeight="SemiBold"/>
                        <Grid Grid.Row="4"
                              Grid.Column="1"
                              ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <TextBlock Text="{Binding SelectedCollaboratorJoinedText}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SelectedCollaboratorOnlineText}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
