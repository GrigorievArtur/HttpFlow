<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Httpflow.Desktop.Features.NodesPanel.ViewModels"
             xmlns:views="using:Httpflow.Desktop.Features.NodesPanel.Views"
             mc:Ignorable="d" d:DesignWidth="392" d:DesignHeight="680"
             x:DataType="vm:NodesPanelViewModel"
             x:Class="Httpflow.Desktop.Features.NodesPanel.Views.NodesPanelView">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:RequestNodePanelViewModel">
            <views:RequestNodePanelView/>
        </DataTemplate>
        <DataTemplate DataType="vm:ExpectedNodePanelViewModel">
            <views:ExpectedNodePanelView/>
        </DataTemplate>
        <DataTemplate DataType="vm:TestDetailsPanelViewModel">
            <views:TestDetailsPanelView/>
        </DataTemplate>
        <DataTemplate DataType="vm:EmptyNodesPanelViewModel">
            <views:EmptyNodesPanelView/>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ContentControl Content="{Binding ActivePanel}"/>
</UserControl>
