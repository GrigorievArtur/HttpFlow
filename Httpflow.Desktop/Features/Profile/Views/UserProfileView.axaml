<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="760"
             x:Class="Httpflow.Desktop.Features.Profile.Views.UserProfileView">
    <Grid Margin="24"
          RowDefinitions="Auto,Auto,Auto,*"
          RowSpacing="22">
        <TextBlock Text="Profile"
                   FontSize="28"
                   FontWeight="SemiBold"/>

        <Border Grid.Row="1"
                Padding="20"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="140,*"
                  RowSpacing="12">
                <TextBlock Text="Name"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="ProfileNameTextBlock"
                           Grid.Column="1"/>

                <TextBlock Grid.Row="1"
                           Text="Email"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="ProfileEmailTextBlock"
                           Grid.Row="1"
                           Grid.Column="1"/>

                <TextBlock Grid.Row="2"
                           Text="User id"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="ProfileUserIdTextBlock"
                           Grid.Row="2"
                           Grid.Column="1"/>

                <TextBlock Grid.Row="3"
                           Text="Theme"
                           FontWeight="SemiBold"/>
                <ComboBox x:Name="ThemeModeComboBox"
                          Grid.Row="3"
                          Grid.Column="1"
                          Width="160"
                          HorizontalAlignment="Left"
                          SelectionChanged="OnThemeModeSelectionChanged">
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                </ComboBox>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Padding="20"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid RowDefinitions="Auto,Auto,*"
                  RowSpacing="12">
                <TextBlock Text="Invites"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock x:Name="InvitesStatusTextBlock"
                           Grid.Row="1"
                           Opacity="0.72"
                           TextWrapping="Wrap"/>
                <StackPanel x:Name="InvitesListPanel"
                            Grid.Row="2"
                            Spacing="10"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3"
                    Spacing="10"
                    HorizontalAlignment="Left">
            <Button Content="Logout"
                    Click="OnLogoutButtonClick"/>
        </StackPanel>
    </Grid>
</UserControl>
