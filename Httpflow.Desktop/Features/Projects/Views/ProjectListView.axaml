<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Httpflow.Desktop.Features.Projects.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="760"
             x:DataType="vm:ProjectListViewModel"
             x:Class="Httpflow.Desktop.Features.Projects.Views.ProjectListView">
    <Grid>
        <Grid Margin="18"
              RowDefinitions="Auto,*"
              ColumnDefinitions="2.4*,3.6*">
            <Grid Grid.Row="0"
                  Grid.Column="0"
                  Margin="0,0,18,12"
                  ColumnDefinitions="*,Auto">
                <TextBox x:Name="ProjectSearchTextBox"
                         PlaceholderText="Search projects"
                         Text="{Binding SearchText, Mode=TwoWay}"/>
                <Button Grid.Column="1"
                        Content="New"
                        Margin="12,0,0,0"
                        Command="{Binding OpenCreateProjectDialogCommand}"/>
            </Grid>

            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Margin="0,0,18,0"
                  RowDefinitions="Auto,*,Auto">
                <TextBlock x:Name="ProjectsStatusTextBlock"
                           Text="{Binding ProjectsStatusText}"/>
                <StackPanel x:Name="ProjectsListPanel"
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            Spacing="12"/>
                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,*,Auto"
                      Margin="0,14,0,0">
                    <Button x:Name="PreviousPageButton"
                            Content="Previous"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}"/>
                    <TextBlock x:Name="ProjectPageTextBlock"
                               Grid.Column="1"
                               Text="{Binding CurrentPageDisplay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button x:Name="NextPageButton"
                            Grid.Column="2"
                            Content="Next"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Spacing="14">
                <TextBlock x:Name="CurrentUserTextBlock"
                           Text="{Binding QuickActionsText}"/>

                <Border Classes.quick-actions-panel="True">
                    <Grid RowDefinitions="Auto,Auto"
                          RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="12">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding SelectedProjectName}"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding QuickActionsStatusText}"
                                           FontSize="12"
                                           Opacity="0.72"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    MinWidth="132"
                                    Command="{Binding RunAllTestsCommand}"
                                    IsEnabled="{Binding CanRunSelectedProject}">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <PathIcon Width="14"
                                              Height="14"
                                              Data="M4,3 L16,10 L4,17 Z"/>
                                    <TextBlock Text="Run tests"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1"
                              IsVisible="{Binding IsRunProgressVisible}"
                              RowDefinitions="Auto,Auto"
                              RowSpacing="4">
                            <TextBlock Text="{Binding RunProgressText}"
                                       FontSize="11"
                                       Opacity="0.74"/>
                            <ProgressBar Grid.Row="1"
                                         Height="7"
                                         Maximum="{Binding RunProgressMaximum}"
                                         Value="{Binding RunProgressValue}"
                                         Foreground="#3DBB7D"
                                         IsVisible="{Binding IsRunProgressHealthy}"/>
                            <ProgressBar Grid.Row="1"
                                         Height="7"
                                         Maximum="{Binding RunProgressMaximum}"
                                         Value="{Binding RunProgressValue}"
                                         Foreground="#D94A4A"
                                         IsVisible="{Binding IsRunProgressError}"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid RowDefinitions="Auto,*"
                      RowSpacing="10">
                    <TextBlock Text="{Binding QuickActionTestsStatusText}"
                               FontWeight="SemiBold"/>

                    <ScrollViewer Grid.Row="1"
                                  MinHeight="320"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding QuickActionTests}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProjectQuickActionTestViewModel">
                                    <Border Classes.quick-test-row="True"
                                            Margin="0,0,0,10">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="12">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="Auto,*"
                                                      ColumnSpacing="8">
                                                    <Border Classes.order-pill="True"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Order}"
                                                                   FontSize="11"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                </Grid>
                                                <TextBlock Text="{Binding NodeCountText}"
                                                           FontSize="12"
                                                           Opacity="0.72"/>
                                            </StackPanel>

                                            <Grid Grid.Column="1"
                                                  VerticalAlignment="Top">
                                                <Border Classes="quick-test-status passed"
                                                        IsVisible="{Binding IsPassed}">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"/>
                                                </Border>
                                                <Border Classes="quick-test-status failed"
                                                        IsVisible="{Binding IsFailed}">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"/>
                                                </Border>
                                                <Border Classes="quick-test-status running"
                                                        IsVisible="{Binding IsRunning}">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"/>
                                                </Border>
                                                <Border Classes="quick-test-status waiting"
                                                        IsVisible="{Binding IsWaiting}">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"/>
                                                </Border>
                                                <Border Classes="quick-test-status neutral"
                                                        IsVisible="{Binding IsNeutral}">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="11"/>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </StackPanel>
        </Grid>

        <Border x:Name="CreateProjectOverlay"
                IsVisible="{Binding IsCreateProjectDialogOpen}"
                Background="#80000000">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="24">
                <Border Padding="24"
                        MinWidth="320"
                        MaxWidth="420"
                        Classes.project-create-card="True">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Create project"
                                   FontSize="20"/>
                        <TextBox x:Name="ProjectNameTextBox"
                                 FontSize="18"
                                 FontWeight="SemiBold"
                                 PlaceholderText="Enter project name"
                                 Text="{Binding CreateProjectName, Mode=TwoWay}"/>
                        <TextBlock x:Name="CreateProjectMessageTextBlock"
                                   IsVisible="{Binding HasCreateProjectMessage}"
                                   Text="{Binding CreateProjectMessage}"
                                   TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,*"
                              Margin="0,8,0,0">
                            <Button x:Name="CancelCreateProjectButton"
                                    Grid.Column="0"
                                    Content="Cancel"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding CancelCreateProjectDialogCommand}"
                                    IsEnabled="{Binding IsCreateProjectButtonsEnabled}"
                                    Margin="0,0,6,0"/>
                            <Button x:Name="ConfirmCreateProjectButton"
                                    Grid.Column="1"
                                    Content="Create"
                                    Classes="accent"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ConfirmCreateProjectCommand}"
                                    IsEnabled="{Binding IsCreateProjectButtonsEnabled}"
                                    Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
