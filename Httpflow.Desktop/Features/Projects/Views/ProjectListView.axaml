<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Httpflow.Desktop.Features.Projects.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="760"
             x:DataType="vm:ProjectListViewModel"
             x:Class="Httpflow.Desktop.Features.Projects.Views.ProjectListView">
    <Grid>
        <Grid Margin="18"
              RowDefinitions="Auto,*"
              ColumnDefinitions="2.4*,3.6*">
            <Grid Grid.Row="0"
                  Grid.Column="0"
                  Margin="0,0,18,12"
                  ColumnDefinitions="*,Auto">
                <TextBox x:Name="ProjectSearchTextBox"
                         PlaceholderText="Search projects"
                         Text="{Binding SearchText, Mode=TwoWay}"/>
                <Button Grid.Column="1"
                        Content="New"
                        Margin="12,0,0,0"
                        Command="{Binding OpenCreateProjectDialogCommand}"/>
            </Grid>

            <Grid Grid.Row="1"
                  Grid.Column="0"
                  Margin="0,0,18,0"
                  RowDefinitions="Auto,*,Auto">
                <TextBlock x:Name="ProjectsStatusTextBlock"
                           Text="{Binding ProjectsStatusText}"/>
                <StackPanel x:Name="ProjectsListPanel"
                            Grid.Row="1"
                            Margin="0,12,0,0"
                            Spacing="12"/>
                <Grid Grid.Row="2"
                      ColumnDefinitions="Auto,*,Auto"
                      Margin="0,14,0,0">
                    <Button x:Name="PreviousPageButton"
                            Content="Previous"
                            Command="{Binding PreviousPageCommand}"
                            IsEnabled="{Binding CanGoPrevious}"/>
                    <TextBlock x:Name="ProjectPageTextBlock"
                               Grid.Column="1"
                               Text="{Binding CurrentPageDisplay}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    <Button x:Name="NextPageButton"
                            Grid.Column="2"
                            Content="Next"
                            Command="{Binding NextPageCommand}"
                            IsEnabled="{Binding CanGoNext}"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Spacing="14">
                <TextBlock x:Name="CurrentUserTextBlock"
                           Text="{Binding QuickActionsText}"/>

                <Button Content="Run all tests"/>

                <TextBlock Text="Group tests"
                           Margin="0,10,0,0"/>

                <Separator/>

                <TextBlock Text="Group1"
                           Margin="0,10,0,0"/>
                <Button Content="Run group test"/>

                <TextBlock Text="Group2"
                           Margin="0,10,0,0"/>
                <Button Content="Run group test"/>
            </StackPanel>
        </Grid>

        <Border x:Name="CreateProjectOverlay"
                IsVisible="{Binding IsCreateProjectDialogOpen}"
                Background="#80000000">
            <Grid HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Margin="24">
                <Border Padding="24"
                        MinWidth="320"
                        MaxWidth="420">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Create project"
                                   FontSize="20"/>
                        <TextBlock Text="Project name"/>
                        <TextBox x:Name="ProjectNameTextBox"
                                 PlaceholderText="Enter project name"
                                 Text="{Binding CreateProjectName, Mode=TwoWay}"/>
                        <TextBlock x:Name="CreateProjectMessageTextBlock"
                                   IsVisible="{Binding HasCreateProjectMessage}"
                                   Text="{Binding CreateProjectMessage}"
                                   TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,*"
                              Margin="0,8,0,0">
                            <Button x:Name="CancelCreateProjectButton"
                                    Grid.Column="0"
                                    Content="Cancel"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding CancelCreateProjectDialogCommand}"
                                    IsEnabled="{Binding IsCreateProjectButtonsEnabled}"
                                    Margin="0,0,6,0"/>
                            <Button x:Name="ConfirmCreateProjectButton"
                                    Grid.Column="1"
                                    Content="Create"
                                    Classes="accent"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding ConfirmCreateProjectCommand}"
                                    IsEnabled="{Binding IsCreateProjectButtonsEnabled}"
                                    Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
