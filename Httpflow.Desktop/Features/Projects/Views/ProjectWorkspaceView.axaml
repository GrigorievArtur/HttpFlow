<UserControl x:Name="WorkspaceRoot"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Httpflow.Desktop.Features.Projects.ViewModels"
             xmlns:nodesPanel="using:Httpflow.Desktop.Features.NodesPanel.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="680"
             x:DataType="vm:ProjectWorkspaceViewModel"
             Focusable="True"
             KeyDown="OnWorkspaceKeyDown"
             PointerMoved="OnWorkspacePointerMoved"
             PointerReleased="OnWorkspacePointerReleased"
             Classes.workspace-root="True"
             x:Class="Httpflow.Desktop.Features.Projects.Views.ProjectWorkspaceView">
    <Grid x:Name="WorkspaceLayout"
          ColumnDefinitions="*,Auto,392"
          Classes.workspace-layout="True">
        <Grid Grid.Column="0"
              RowDefinitions="Auto,*"
              Margin="16">
            <Border Grid.Row="0"
                    Classes.workspace-header="True">
                <Grid RowDefinitions="Auto,Auto"
                      RowSpacing="8">
                    <TextBox Text="{Binding ProjectTitle, Mode=TwoWay}"
                             Classes.project-title-editor="True"
                             VerticalAlignment="Center"
                             FontWeight="SemiBold"/>
                    <Grid Grid.Row="1"
                          IsVisible="{Binding IsRunProgressVisible}"
                          RowDefinitions="Auto,Auto"
                          RowSpacing="4">
                        <TextBlock Text="{Binding RunProgressText}"
                                   FontSize="11"
                                   Opacity="0.74"/>
                        <ProgressBar Grid.Row="1"
                                     Height="7"
                                     Maximum="{Binding RunProgressMaximum}"
                                     Value="{Binding RunProgressValue}"
                                     Foreground="#3DBB7D"
                                     IsVisible="{Binding IsRunProgressHealthy}"/>
                        <ProgressBar Grid.Row="1"
                                     Height="7"
                                     Maximum="{Binding RunProgressMaximum}"
                                     Value="{Binding RunProgressValue}"
                                     Foreground="#D94A4A"
                                     IsVisible="{Binding IsRunProgressError}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Classes.workspace-board="True"
                    ClipToBounds="True">
                <Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="14"
                                    Margin="12,0,12,0"
                                    VerticalAlignment="Stretch"
                                    Classes.workspace-task-strip="True">
                            <ItemsControl ItemsSource="{Binding Tests}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="14"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkspaceTestColumnViewModel">
                                        <Border Width="220"
                                                Height="{ReflectionBinding Bounds.Height, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                Classes.test-column="True"
                                                Classes.selected="{Binding IsSelected}"
                                                VerticalAlignment="Stretch"
                                                PointerPressed="OnTestColumnPointerPressed"
                                                PointerEntered="OnTestColumnPointerEnter"
                                                PointerReleased="OnTestColumnPointerReleased"
                                                Tag="{Binding}">
                                            <Grid RowDefinitions="Auto,*"
                                                  RowSpacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="8">
                                                        <Button Width="24"
                                                                Height="24"
                                                                Padding="0"
                                                                Classes.drag-grip="True"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                ToolTip.Tip="Drag task"
                                                                PointerPressed="OnTestGripPointerPressed"
                                                                PointerReleased="OnTestGripPointerReleased"
                                                                Tag="{Binding}">
                                                            <PathIcon Width="12"
                                                                      Height="12"
                                                                      Data="M2,4 H6 V8 H2 Z M10,4 H14 V8 H10 Z M2,12 H6 V16 H2 Z M10,12 H14 V16 H10 Z"/>
                                                        </Button>
                                                        <TextBlock Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold"/>
                                                        <Border Padding="5,1"
                                                                Classes.order-pill="True">
                                                            <TextBlock Text="{Binding Order}"
                                                                       FontSize="11"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            Classes.icon-button="True"
                                                            ToolTip.Tip="Delete task"
                                                            Command="{ReflectionBinding DataContext.DeleteTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}">
                                                        <PathIcon Width="12"
                                                                  Height="12"
                                                                  Data="M4,6 H16 M7,6 V4 H13 V6 M7,8 V16 M10,8 V16 M13,8 V16 M5,6 L6,18 H14 L15,6"/>
                                                    </Button>
                                                </Grid>

                                                <ScrollViewer Grid.Row="1"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Spacing="0">
                                                        <ItemsControl ItemsSource="{Binding Nodes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:WorkspaceNodeCardViewModel">
                                                                    <StackPanel Spacing="8"
                                                                                Margin="0,0,0,8">
                                                                        <Border MinHeight="108"
                                                                                Classes.node-card="True"
                                                                                Classes.selected="{Binding IsSelected}"
                                                                                PointerPressed="OnNodeCardPointerPressed"
                                                                                PointerEntered="OnNodeCardPointerEnter"
                                                                                PointerReleased="OnNodeCardPointerReleased"
                                                                                Tag="{Binding}">
                                                                            <Border.ContextMenu>
                                                                                <ContextMenu>
                                                                                    <MenuItem Header="Copy    Ctrl+C"
                                                                                              Click="OnCopyNodeMenuItemClick"
                                                                                              Tag="{Binding}"/>
                                                                                    <MenuItem Header="Paste    Ctrl+V"
                                                                                              Click="OnPasteNodeMenuItemClick"
                                                                                              Tag="{Binding}"/>
                                                                                    <MenuItem Header="Cut    Ctrl+X"
                                                                                              Click="OnCutNodeMenuItemClick"
                                                                                              Tag="{Binding}"/>
                                                                                    <MenuItem Header="Duplicate    Ctrl+D"
                                                                                              Click="OnDuplicateNodeMenuItemClick"
                                                                                              Tag="{Binding}"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="Insert Before"
                                                                                              Click="OnInsertNodeBeforeMenuItemClick"
                                                                                              Tag="{Binding}"/>
                                                                                    <MenuItem Header="Insert After    Space"
                                                                                              Click="OnInsertNodeAfterMenuItemClick"
                                                                                              Tag="{Binding}"/>
                                                                                </ContextMenu>
                                                                            </Border.ContextMenu>
                                                                            <StackPanel Spacing="8">
                                                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                                                      ColumnSpacing="8">
                                                                                    <Button Width="24"
                                                                                            Height="24"
                                                                                            Padding="0"
                                                                                            Classes.drag-grip="True"
                                                                                            HorizontalContentAlignment="Center"
                                                                                            VerticalContentAlignment="Center"
                                                                                            ToolTip.Tip="Drag node"
                                                                                            PointerPressed="OnNodeGripPointerPressed"
                                                                                            PointerReleased="OnNodeGripPointerReleased"
                                                                                            Tag="{Binding}">
                                                                                        <PathIcon Width="12"
                                                                                                  Height="12"
                                                                                                  Data="M7,2 H9 V4 H7 Z M11,2 H13 V4 H11 Z M7,7 H9 V9 H7 Z M11,7 H13 V9 H11 Z M7,12 H9 V14 H7 Z M11,12 H13 V14 H11 Z"/>
                                                                                    </Button>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding Name}"
                                                                                               VerticalAlignment="Center"
                                                                                               FontSize="15"
                                                                                               FontWeight="SemiBold"/>
                                                                                    <Border Grid.Column="2"
                                                                                            Classes.order-pill="True">
                                                                                        <TextBlock Text="{Binding Order}"
                                                                                                   FontSize="11"/>
                                                                                    </Border>
                                                                                </Grid>

                                                                                <Grid ColumnDefinitions="Auto,*"
                                                                                      ColumnSpacing="8">
                                                                                    <TextBlock Text="{Binding PrimaryInfo}"
                                                                                               FontSize="12"
                                                                                               FontWeight="SemiBold"/>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding SecondaryInfo}"
                                                                                               FontSize="12"
                                                                                               TextAlignment="Right"/>
                                                                                </Grid>

                                                                                <Border HorizontalAlignment="Left"
                                                                                        Margin="0,4,0,0"
                                                                                        Classes.node-type-pill="True">
                                                                                    <TextBlock Text="{Binding NodeType}"
                                                                                               Foreground="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                                                                               FontSize="10"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <TextBlock HorizontalAlignment="Center"
                                                                                   FontSize="20"
                                                                                   FontWeight="Bold"
                                                                                   Classes.node-connector="True"
                                                                                   IsVisible="{Binding ShowConnector}"
                                                                                   Text="↓"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Button Width="34"
                                                                Height="34"
                                                                Margin="0,4,0,0"
                                                                HorizontalAlignment="Center"
                                                                Padding="0"
                                                                Classes.icon-button="True"
                                                                Classes.add-node-button="True"
                                                                ToolTip.Tip="Add node"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                Click="OnAddNodeButtonClick"
                                                                Tag="{Binding}">
                                                            <PathIcon Width="16"
                                                                      Height="16"
                                                                      Data="M10,2 L10,10 L18,10 L18,14 L10,14 L10,22 L6,22 L6,14 L-2,14 L-2,10 L6,10 L6,2 Z"/>
                                                        </Button>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Width="58"
                                    Height="58"
                                    Margin="0,0,0,0"
                                    VerticalAlignment="Top"
                                    Padding="0"
                                    Classes.add-test-button="True"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding AddTestCommand}">
                                <TextBlock Text="Add&#x0a;Test"
                                           FontSize="11"
                                           TextAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Column="1"
                x:Name="SidebarToggleButton"
                Width="36"
                Height="36"
                Margin="0,16,0,0"
                Padding="0"
                VerticalAlignment="Top"
                Classes.sidebar-toggle-button="True"
                Content="{Binding SidebarToggleText}"
                Command="{Binding ToggleSidebarCommand}"/>

        <Border Grid.Column="2"
                x:Name="SidebarPanel"
                IsVisible="{Binding IsSidebarOpen}"
                Classes.workspace-sidebar="True">
            <nodesPanel:NodesPanelView DataContext="{Binding NodesPanel}"/>
        </Border>
    </Grid>
</UserControl>
