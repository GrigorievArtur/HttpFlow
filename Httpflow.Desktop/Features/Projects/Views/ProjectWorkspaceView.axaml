<UserControl x:Name="WorkspaceRoot"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Httpflow.Desktop.Features.Projects.ViewModels"
             xmlns:nodesPanel="using:Httpflow.Desktop.Features.NodesPanel.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="680"
             x:DataType="vm:ProjectWorkspaceViewModel"
             Focusable="True"
             KeyDown="OnWorkspaceKeyDown"
             PointerMoved="OnWorkspacePointerMoved"
             PointerReleased="OnWorkspacePointerReleased"
             x:Class="Httpflow.Desktop.Features.Projects.Views.ProjectWorkspaceView">
    <UserControl.Styles>
        <Style Selector="Border.test-column.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="3"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
        </Style>
        <Style Selector="Border.node-card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"/>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="WorkspaceLayout"
          ColumnDefinitions="*,Auto,392"
          Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <Grid Grid.Column="0"
              RowDefinitions="Auto,*"
              Margin="16">
            <Border Grid.Row="0"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8">
                <Grid>
                    <TextBlock Text="{Binding ProjectTitle}"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid MinHeight="620">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="14"
                                    Margin="12">
                            <ItemsControl ItemsSource="{Binding Tests}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="14"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorkspaceTestColumnViewModel">
                                        <Border Width="220"
                                                Height="{ReflectionBinding Bounds.Height, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                                                Padding="10"
                                                Classes.test-column="True"
                                                Classes.selected="{Binding IsSelected}"
                                                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                BorderThickness="1"
                                                CornerRadius="0"
                                                VerticalAlignment="Stretch"
                                                PointerPressed="OnTestColumnPointerPressed"
                                                PointerEntered="OnTestColumnPointerEnter"
                                                PointerReleased="OnTestColumnPointerReleased"
                                                Tag="{Binding}">
                                            <Grid RowDefinitions="Auto,*"
                                                  RowSpacing="10">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="8">
                                                        <Button Width="24"
                                                                Height="24"
                                                                Padding="0"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                PointerPressed="OnTestGripPointerPressed"
                                                                PointerReleased="OnTestGripPointerReleased"
                                                                Tag="{Binding}">
                                                            <PathIcon Width="12"
                                                                      Height="12"
                                                                      Data="M2,4 H6 V8 H2 Z M10,4 H14 V8 H10 Z M2,12 H6 V16 H2 Z M10,12 H14 V16 H10 Z"/>
                                                        </Button>
                                                        <TextBlock Text="{Binding Name}"
                                                                   VerticalAlignment="Center"
                                                                   FontSize="18"
                                                                   FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0"
                                                            Command="{ReflectionBinding DataContext.DeleteTestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding Id}">
                                                        <PathIcon Width="12"
                                                                  Height="12"
                                                                  Data="M4,6 H16 M7,6 V4 H13 V6 M7,8 V16 M10,8 V16 M13,8 V16 M5,6 L6,18 H14 L15,6"/>
                                                    </Button>
                                                </Grid>

                                                <ScrollViewer Grid.Row="1"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <StackPanel Spacing="0">
                                                        <ItemsControl ItemsSource="{Binding Nodes}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:WorkspaceNodeCardViewModel">
                                                                    <StackPanel Spacing="8"
                                                                                Margin="0,0,0,8">
                                                                        <Border MinHeight="108"
                                                                                Padding="10"
                                                                                Classes.node-card="True"
                                                                                Classes.selected="{Binding IsSelected}"
                                                                                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                                                                                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="0"
                                                                                PointerPressed="OnNodeCardPointerPressed"
                                                                                PointerEntered="OnNodeCardPointerEnter"
                                                                                PointerReleased="OnNodeCardPointerReleased"
                                                                                Tag="{Binding}">
                                                                            <StackPanel Spacing="8">
                                                                                <Grid ColumnDefinitions="*,Auto"
                                                                                      ColumnSpacing="8">
                                                                                    <TextBlock Text="{Binding Name}"
                                                                                               VerticalAlignment="Center"
                                                                                               FontSize="15"
                                                                                               FontWeight="SemiBold"/>
                                                                                </Grid>

                                                                                <Grid ColumnDefinitions="Auto,*"
                                                                                      ColumnSpacing="8">
                                                                                    <TextBlock Text="{Binding RequestMethod}"
                                                                                               FontSize="12"
                                                                                               FontWeight="SemiBold"/>
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding Host}"
                                                                                               FontSize="12"
                                                                                               TextAlignment="Right"/>
                                                                                </Grid>

                                                                                <Border HorizontalAlignment="Left"
                                                                                        Margin="0,4,0,0"
                                                                                        Padding="6,2"
                                                                                        Background="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"
                                                                                        CornerRadius="0">
                                                                                    <TextBlock Text="{Binding NodeType}"
                                                                                               Foreground="{DynamicResource SystemControlBackgroundAltHighBrush}"
                                                                                               FontSize="10"/>
                                                                                </Border>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <TextBlock HorizontalAlignment="Center"
                                                                                   FontSize="20"
                                                                                   FontWeight="Bold"
                                                                                   IsVisible="{Binding ShowConnector}"
                                                                                   Text="↓"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>

                                                        <Button Width="34"
                                                                Height="34"
                                                                Margin="0,4,0,0"
                                                                HorizontalAlignment="Center"
                                                                Padding="0"
                                                                HorizontalContentAlignment="Center"
                                                                VerticalContentAlignment="Center"
                                                                Click="OnAddNodeButtonClick"
                                                                Tag="{Binding}">
                                                            <PathIcon Width="16"
                                                                      Height="16"
                                                                      Data="M10,2 L10,10 L18,10 L18,14 L10,14 L10,22 L6,22 L6,14 L-2,14 L-2,10 L6,10 L6,2 Z"/>
                                                        </Button>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Width="58"
                                    Height="58"
                                    Margin="0,10,0,0"
                                    VerticalAlignment="Top"
                                    Padding="0"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Command="{Binding AddTestCommand}">
                                <TextBlock Text="Add&#x0a;Test"
                                           FontSize="11"
                                           TextAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Column="1"
                x:Name="SidebarToggleButton"
                Width="36"
                Height="36"
                Margin="0,16,0,0"
                Padding="0"
                VerticalAlignment="Top"
                Content="{Binding SidebarToggleText}"
                Command="{Binding ToggleSidebarCommand}"/>

        <Border Grid.Column="2"
                x:Name="SidebarPanel"
                IsVisible="{Binding IsSidebarOpen}"
                Padding="22,18"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1,0,0,0">
            <nodesPanel:NodesPanelView DataContext="{Binding NodesPanel}"/>
        </Border>
    </Grid>
</UserControl>
