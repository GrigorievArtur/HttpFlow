<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Httpflow.Desktop.Shell.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="760"
        x:Class="Httpflow.Desktop.Shell.Views.AppShellWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="Httpflow"
        Width="1100"
        Height="760"
        MinWidth="960"
        MinHeight="680">

    <DockPanel>
        <controls:AppNavigationBar x:Name="NavigationBar"
                            DockPanel.Dock="Top"/>

        <ContentControl x:Name="MainContent"/>
    </DockPanel>
</Window>
