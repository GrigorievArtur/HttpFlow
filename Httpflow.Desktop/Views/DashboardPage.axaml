<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="1200"
             d:DesignHeight="700"
             x:Class="Httpflow.Desktop.Views.DashboardPage">

    <Border Padding="18"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        <Grid ColumnDefinitions="420,*"
              RowDefinitions="Auto,*">
            <Grid Grid.Row="0"
                  Grid.Column="0"
                  Margin="0,0,16,12"
                  ColumnDefinitions="*,Auto">
                <TextBox x:Name="SearchTextBox"
                         PlaceholderText="Search teammates"
                         TextChanged="SearchTextBox_OnTextChanged"/>
                <Button Grid.Column="1"
                        Width="42"
                        Margin="10,0,0,0"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Content="⇅"/>
            </Grid>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,16,0"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <ScrollViewer>
                    <StackPanel x:Name="TeammatesListPanel"
                                Spacing="0"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.RowSpan="2"
                  Grid.Column="1"
                  RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
                  RowSpacing="14">
                <TextBlock Text="Email"
                           FontSize="16"
                           FontWeight="SemiBold"/>

                <TextBox Grid.Row="1"
                         PlaceholderText="teammate@company.com"/>

                <Button Grid.Row="2"
                        Height="44"
                        Content="+ Invite teammate"
                        FontWeight="SemiBold"/>

                <TextBlock Grid.Row="3"
                           Text="Selected user data"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,10,0,0"/>

                <Border Grid.Row="4"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*"
                          ColumnDefinitions="120,*"
                          RowSpacing="18"
                          ColumnSpacing="12">
                        <TextBlock Grid.ColumnSpan="2"
                                   x:Name="SelectedNameTextBlock"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Text="Name: Alex Johnson"/>

                        <TextBlock Grid.Row="1"
                                   Text="Role"
                                   VerticalAlignment="Center"/>
                        <ComboBox x:Name="RoleComboBox"
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Width="180"
                                  SelectionChanged="RoleComboBox_OnSelectionChanged">
                            <ComboBoxItem Content="Admin"/>
                            <ComboBoxItem Content="Member"/>
                            <ComboBoxItem Content="Viewer"/>
                        </ComboBox>

                        <TextBlock Grid.Row="2"
                                   Text="Invited"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="InvitedTextBlock"
                                   Grid.Row="2"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="2024-01-14"/>

                        <TextBlock Grid.Row="3"
                                   Text="Last login"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="LastLoginTextBlock"
                                   Grid.Row="3"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="2026-05-05 09:42"/>

                        <TextBlock Grid.Row="4"
                                   Grid.ColumnSpan="2"
                                   x:Name="StatusTextBlock"
                                   VerticalAlignment="Top"
                                   Text="Status: Online"/>
                    </Grid>
                </Border>

                <TextBlock Grid.Row="5"
                           Text="Danger Zone"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <Button Grid.Row="6"
                        HorizontalAlignment="Left"
                        Padding="28,14"
                        Content="Eliminate user"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
