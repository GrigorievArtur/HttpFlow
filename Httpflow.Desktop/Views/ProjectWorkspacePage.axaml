<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="680"
             x:Class="Httpflow.Desktop.Views.ProjectWorkspacePage">

    <Grid x:Name="WorkspaceLayout"
          ColumnDefinitions="*,Auto,392"
          Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
        <Grid Grid.Column="0"
              RowDefinitions="Auto,*"
              Margin="16">
            <Border Grid.Row="0"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="Project 1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1"
                               Text="100%"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <TextBlock Text="Nodes viewport"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

                    <StackPanel HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="12"
                                Spacing="6">
                        <TextBlock Text="100%"
                                   FontWeight="SemiBold"/>
                        <Button Width="36"
                                Height="36"
                                Padding="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">
                            <PathIcon Width="18"
                                      Height="18"
                                      Data="M4,4 L14,4 M4,14 L14,14 M4,4 L4,14 M14,4 L14,14 M7,7 L11,7 M7,11 L11,11 M7,7 L7,11 M11,7 L11,11"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Button Grid.Column="1"
                x:Name="SidebarToggleButton"
                Width="36"
                Height="36"
                Margin="0,16,0,0"
                Padding="0"
                VerticalAlignment="Top"
                Content=">>"
                Click="SidebarToggleButton_OnClick"/>

        <Border Grid.Column="2"
                x:Name="SidebarPanel"
                Padding="22,18"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,Auto,*,*">
                <TextBlock Text="Http Request Name"
                           FontSize="22"
                           FontWeight="SemiBold"/>

                <Grid Grid.Row="1"
                      Margin="0,22,0,16"
                      ColumnDefinitions="130,*,44"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12">
                    <TextBlock Text="Method"
                               FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1"
                               Text="Api link"
                               FontWeight="SemiBold"/>

                    <ComboBox Grid.Row="1"
                              SelectedIndex="0">
                        <ComboBoxItem Content="GET"/>
                        <ComboBoxItem Content="POST"/>
                        <ComboBoxItem Content="PUT"/>
                        <ComboBoxItem Content="PATCH"/>
                        <ComboBoxItem Content="DELETE"/>
                    </ComboBox>

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             PlaceholderText="https://api.example.com"/>

                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Padding="0"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <PathIcon Width="20"
                                  Height="20"
                                  Data="M4,3 L18,10 L4,17 L7,10 Z"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="2"
                      RowDefinitions="Auto,*"
                      Margin="0,0,0,16">
                    <TextBlock Text="Json data"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="1"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             PlaceholderText="JSON body"/>
                </Grid>

                <Grid Grid.Row="3"
                      RowDefinitions="Auto,*">
                    <TextBlock Text="Response"
                               FontWeight="SemiBold"/>
                    <TextBox Grid.Row="1"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             IsReadOnly="True"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
